{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "read": "allow",
    "bash": "ask",
    "webfetch": "ask",
    "websearch": "allow",
    "git push": "ask",
    "git log*": "allow",
    "git status": "allow"
  },
  "lsp": true,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "temperature": 0.2
    }
  }
}
